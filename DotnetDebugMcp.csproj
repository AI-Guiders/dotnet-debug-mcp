<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotnetDebugMcp</RootNamespace>
    <AssemblyName>DotnetDebugMcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="DotnetDebugMcp.Tests\**\*.cs" />
    <None Remove="DotnetDebugMcp.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DotnetDebugMcp.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ExportMcpManifest</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Monorepo / sibling: ProjectReference. Standalone clone (CI): NuGet 0.2.0+. -->
    <ProjectReference Include="..\dotnet-debug-core\DotnetDebug.Core.csproj" Condition="Exists('..\dotnet-debug-core\DotnetDebug.Core.csproj')" />
    <PackageReference Include="AIGuiders.DotnetDebugMCP.Core" Version="0.2.0" Condition="!Exists('..\dotnet-debug-core\DotnetDebug.Core.csproj')" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
  </ItemGroup>

</Project>
